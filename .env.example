# Staging/prod (Railway): OBRIGATÓRIO same-origin — NÃO use URL completa da API.
VITE_API_BASE_URL=/api
# Dev local: proxy Vite encaminha /api para a API
VITE_API_PROXY_TARGET=https://api-staging-61ce.up.railway.app
# Dev local: mesmo valor da API (header X-Glow-Proxy-Secret no proxy Vite)
GLOW_PROXY_SECRET=
VITE_APP_NAME=Glow Up Connect
VITE_APP_URL=https://app.glowupconnect.com.br
VITE_SITE_URL=https://glowupconnect.com.br
VITE_WHATSAPP_NUMBER=
# Lojas (TipoAssinatura.Estabelecimento): oculta aquisição e descoberta. true para reativar.
VITE_FEATURE_LOJAS=false

# Auth (mesmo site key do app, se reCAPTCHA estiver ativo na API)
# VITE_CAPTCHA_SITE_KEY=
# VITE_TOKEN_HEADER=x-glow-token

# Railway (runtime Caddy — não vai no build Vite):
# GLOW_PROXY_SECRET=          # OBRIGATÓRIO — mesmo valor do serviço da API e do app
# API_INTERNAL_HOST=          # ex.: glow-up-connect-api.railway.internal
# API_INTERNAL_URL=           # opcional: https://<servico-api>.railway.internal (sem porta)
# MTLS_UPSTREAM_PORT=8443     # se a API usa mTLS (igual ao app staging)
# MTLS_CLIENT_CERT / MTLS_CLIENT_KEY / MTLS_CA_CERT  # copiar do serviço do app
# MTLS_SERVER_NAME=glowapi.internal
